# =============================================================================
# call-operator — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
LLM_PROVIDER=openai              # openai | anthropic | google
LLM_MODEL=gpt-4o                 # Model name (provider-specific)

# API Keys — provide the key for your chosen provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Speech-to-Text (STT) ---------------------------------------------------
STT_PROVIDER=whisper_local       # whisper_local | deepgram
STT_MODEL=tiny                   # Whisper: tiny|base|small — Deepgram: nova-2

# Deepgram (only if STT_PROVIDER=deepgram)
DEEPGRAM_API_KEY=

# --- Text-to-Speech (TTS) ---------------------------------------------------
TTS_PROVIDER=openai              # openai | elevenlabs | google
TTS_VOICE=alloy                  # Voice name (provider-specific)

# ElevenLabs (only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=

# --- Browser -----------------------------------------------------------------
BROWSER_HEADLESS=true            # false to see the browser during development

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG for verbose output

# --- Audio -------------------------------------------------------------------
AUDIO_SAMPLE_RATE=16000          # Hz — standard for speech processing
VAD_THRESHOLD=0.5                # Silero VAD speech probability threshold (0.0-1.0)
RECORD_AUDIO=false               # true to save audio recordings to data/
